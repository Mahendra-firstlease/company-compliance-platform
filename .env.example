# =================================================================
# FIRSTLEASE COMPLIANCE PLATFORM - MASTER ENVIRONMENT TEMPLATE
# Copy this file to .env.local for development or .env.production for production
# =================================================================

# -----------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# -----------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="FirstLease Compliance Platform"
NEXT_PUBLIC_COMPANY="FirstLease India Pvt Ltd"
NEXT_PUBLIC_SITE_URL="http://localhost:3000" # Production: https://compliance.firstlease.com
NEXT_PUBLIC_API_URL="/api"
BASE_API_URL="http://localhost:3001"
NEXT_PUBLIC_LANGUAGE="en"

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Prisma MySQL)
# -----------------------------------------------------------------
# Local XAMPP/MySQL: mysql://root:@localhost:3306/compliance_db
# Production Managed MySQL: mysql://prod_user:password@prod-db-host.com:3306/compliance_prod_db?sslmode=require
DATABASE_URL="mysql://root:@localhost:3306/compliance_db"

# -----------------------------------------------------------------
# 3. NEXTAUTH / AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------
# 32-character secret key for JWT token encryption & session hashing
AUTH_SECRET="firstlease-compliance-secret-key-32-chars-long"
NEXT_AUTH_SECRET="firstlease-compliance-secret-key-32-chars-long"
NEXTAUTH_URL="http://localhost:3000" # Production: https://compliance.firstlease.com

# Optional: Google OAuth Client Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret_here"

# -----------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY CONFIGURATION
# -----------------------------------------------------------------
# Server-side Key ID (Test mode: rzp_test_..., Live mode: rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_THDaGjZa5ExylM"

# Client-side Key ID (Exposed to browser for Razorpay Checkout JS modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_THDaGjZa5ExylM"

# Server-side Secret Key (Used for HMAC SHA256 Payment Signature Verification)
RAZORPAY_KEY_SECRET="0An2xWcnlWO175ZuICJvKRx8"

# Server-side Webhook Secret (Optional)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# -----------------------------------------------------------------
# 5. INITIAL ADMINISTRATIVE ACCOUNT CREDENTIALS
# -----------------------------------------------------------------
ADMIN_EMAIL="admin@firstlease.com"
ADMIN_PASSWORD="Admin@12345"

# -----------------------------------------------------------------
# 6. AWS S3 / CLOUDFLARE R2 DOCUMENT STORAGE CONFIGURATION
# -----------------------------------------------------------------
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
AWS_S3_BUCKET_NAME="firstlease-compliance-documents"

# =================================================================
# 7. MICROSOFT GRAPH API EMAIL CONFIGURATION (EXCLUSIVE PROVIDER)
# Register App in Azure Active Directory (App Registrations) with Mail.Send permission
# =================================================================
MS_GRAPH_TENANT_ID="your_azure_tenant_id_here"
MS_GRAPH_CLIENT_ID="your_azure_app_client_id_here"
MS_GRAPH_CLIENT_SECRET="your_azure_app_client_secret_here"
MS_GRAPH_SENDER_EMAIL="firstlease@firstlease.in"
ADMIN_ALERT_EMAIL="firstlease@firstlease.in"

