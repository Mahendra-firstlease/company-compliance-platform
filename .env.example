# =================================================================
# COMPLIANCE PORTAL INDIA - MASTER ENVIRONMENT TEMPLATE
# For local development: copy to .env.development or .env.local
# For production: see .env.production.example or configure in host settings
# =================================================================

# -----------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# -----------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Compliance Portal India"
NEXT_PUBLIC_COMPANY="Compliance Portal India Pvt Ltd"
# Dev: http://localhost:3000 | Prod: https://complianceportalindia.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_EMAIL_ASSET_URL="https://complianceportalindia.com"
NEXT_PUBLIC_API_URL="/api"
NEXT_PUBLIC_LANGUAGE="en"

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Prisma MySQL)
# -----------------------------------------------------------------
# Local MySQL: mysql://root:@localhost:3306/compliance_db
# Prod Managed MySQL: mysql://user:password@host:port/dbname?sslmode=require
DATABASE_URL="mysql://root:@localhost:3306/compliance_db"

# -----------------------------------------------------------------
# 3. NEXTAUTH / AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------
AUTH_SECRET="generate_with_openssl_rand_hex_32"
NEXT_AUTH_SECRET="generate_with_openssl_rand_hex_32"
# Dev: http://localhost:3000 | Prod: https://complianceportalindia.com
NEXT_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your_google_client_secret_here"

# -----------------------------------------------------------------
# 4. RAZORPAY PAYMENT GATEWAY CONFIGURATION
# -----------------------------------------------------------------
# Dev (Test Key): rzp_test_... | Prod (Live Key): rzp_live_...
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# -----------------------------------------------------------------
# 5. ADMINISTRATIVE ACCOUNT
# -----------------------------------------------------------------
ADMIN_EMAIL="admin@complianceportalindia.com"
ADMIN_PASSWORD="YourStrongAdminPasswordHere123!"

# -----------------------------------------------------------------
# 6. AWS S3 STORAGE CONFIGURATION
# -----------------------------------------------------------------
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
AWS_S3_BUCKET_NAME="compliance-portal-documents"
AWS_REGION="eu-north-1"

# -----------------------------------------------------------------
# 7. MICROSOFT GRAPH API EMAIL CONFIGURATION (EXCLUSIVE PROVIDER)
# -----------------------------------------------------------------
MS_GRAPH_CLIENT_ID="your_ms_graph_client_id_here"
MS_GRAPH_CLIENT_SECRET="your_ms_graph_client_secret_here"
MS_GRAPH_TENANT_ID="your_ms_graph_tenant_id_here"
MS_GRAPH_SENDER_EMAIL="support@complianceportalindia.com"
ADMIN_ALERT_EMAIL="support@complianceportalindia.com"

# -----------------------------------------------------------------
# 8. RATE LIMITING CONFIGURATION
# -----------------------------------------------------------------
RATE_LIMIT_AUTH_MAX="5"
RATE_LIMIT_AUTH_WINDOW_MS="900000"
RATE_LIMIT_PUBLIC_MAX="15"
RATE_LIMIT_PUBLIC_WINDOW_MS="60000"
RATE_LIMIT_USER_MAX="180"
RATE_LIMIT_USER_WINDOW_MS="60000"

# -----------------------------------------------------------------
# 9. WHATSAPP NOTIFICATION CONFIGURATION
# -----------------------------------------------------------------
WHATSAPP_API_KEY="your_whatsapp_api_key_here"
