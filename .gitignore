# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.vitest/

# AI tools & workspace settings
.cursor/
.agents/

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
Thumbs.db
*.pem
*.key
*.crt
*.pfx
*.log
next-panic-*.log

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment variables (ignore secrets, keep only public template)
.env
.env*.local
.env.development
.env.production
.env.staging
.env.production.example
!.env.example

# database, dumps & local customer storage
/storage/
/storage/**
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql
*.bak
*.tmp

# IDEs & editors
.vscode/
.idea/
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts

# Private documentation & audit reports
PROJECT_INFO.md
AUDIT_REPORT.md
