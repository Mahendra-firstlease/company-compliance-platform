datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  ADMIN
  EXECUTIVE
}

enum ApplicationStatus {
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id               String              @id @default(uuid())
  name             String?
  email            String              @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  phone            String?
  role             Role                @default(CLIENT)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  
  accounts         Account[]
  sessions         Session[]
  businessProfiles BusinessProfile[]
  applications     Application[]       @relation("UserApplications")
  assignedCases    Application[]       @relation("ExecutiveCases")
  documents        Document[]
  payments         Payment[]
  schedules        ComplianceSchedule[]
  certificates     IssuedCertificate[]
  assignedLeads    CrmLead[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BusinessProfile {
  id             String   @id @default(uuid())
  userId         String
  businessName   String
  businessType   String
  industry       String
  state          String
  employeeCount  String
  annualTurnover String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id               String          @id @default(uuid())
  slug             String          @unique
  title            String
  shortDescription String          @db.Text
  description      String          @db.Text
  image            String
  price            Float
  originalPrice    Float?
  governmentFee    Float           @default(0)
  professionalFee  Float
  duration         String
  featured         Boolean         @default(false)
  popular          Boolean         @default(false)
  applications     Application[]
  details          ServiceDetail?
}

model ServiceDetail {
  id                String   @id @default(uuid())
  serviceId         String   @unique
  benefits          Json
  eligibility       Json
  requiredDocuments Json
  faqs              Json
  service           Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Application {
  id                  String            @id
  userId              String
  serviceId           String
  serviceSlug         String
  serviceTitle        String
  status              ApplicationStatus @default(DOCUMENTS_PENDING)
  customerName        String
  customerPhone       String
  address             String            @db.Text
  assignedExecutiveId String?
  queryText           String?           @db.Text
  governmentFee       Float
  professionalFee     Float
  totalFee            Float
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user              User               @relation("UserApplications", fields: [userId], references: [id])
  assignedExecutive User?              @relation("ExecutiveCases", fields: [assignedExecutiveId], references: [id])
  service           Service            @relation(fields: [serviceId], references: [id])
  documents         Document[]
  payments          Payment[]
  certificates      IssuedCertificate[]
}

model Document {
  id            String      @id @default(uuid())
  applicationId String
  userId        String
  docName       String
  fileUrl       String
  fileName      String
  fileSize      String
  fileType      String
  status        String      @default("PENDING")
  createdAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String      @id @default(uuid())
  applicationId String
  userId        String
  amount        Float
  currency      String      @default("INR")
  paymentMethod String
  transactionId String      @unique
  status        String      @default("SUCCESS")
  createdAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
}

model ComplianceSchedule {
  id        String   @id @default(uuid())
  userId    String
  title     String
  type      String
  dueDate   DateTime
  status    String   @default("PENDING")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model IssuedCertificate {
  id              String      @id @default(uuid())
  applicationId   String
  userId          String
  certificateName String
  certificateUrl  String
  issuedDate      DateTime    @default(now())

  application     Application @relation(fields: [applicationId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
}

model CrmLead {
  id                String   @id @default(uuid())
  customerName      String
  customerEmail     String
  customerPhone     String
  interestedService String
  leadStatus        String   @default("NEW")
  notes             String?  @db.Text
  assignedAgentId   String?
  createdAt         DateTime @default(now())

  assignedAgent     User?    @relation(fields: [assignedAgentId], references: [id])
}
